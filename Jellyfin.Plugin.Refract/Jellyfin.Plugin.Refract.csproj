<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Refract</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Refract</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The plugin ships to other people's servers: a warning is not worth a failed build. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1848;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
    <PackageReference Include="Jellyfin.Data" Version="12.1.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/refract.html" />
    <EmbeddedResource Include="Web/refract.js" />
    <EmbeddedResource Include="Web/link.html" />
    <EmbeddedResource Include="Web/widget.js" />
    <EmbeddedResource Include="Web/flow.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests cover the deterministic idempotency key, which stays internal otherwise. -->
    <InternalsVisibleTo Include="Jellyfin.Plugin.Refract.Tests" />
  </ItemGroup>

</Project>
